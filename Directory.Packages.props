<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.10" />
    <PackageVersion Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>
  <ItemGroup Label="Build">
    <!-- Derives the version from the nearest git tag; there is no version stored in any file. -->
    <PackageVersion Include="MinVer" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <!-- xunit v3 on the Microsoft.Testing.Platform; replaces the VSTest trio
         (Microsoft.NET.Test.Sdk + xunit.v3 + xunit.runner.visualstudio). -->
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.0" />
  </ItemGroup>
</Project>
