<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>VisualBasicFormatter</RootNamespace>
    <Description>A VB.NET source formatter that wraps long lines and long method signatures.</Description>
    <!-- The engine ships inside the vbnet-format tool package, which carries its own copy of this
         assembly. Publishing it separately would make its surface a public API to keep stable. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brings in Microsoft.CodeAnalysis.VisualBasic: the parser and SyntaxFactory. The formatter
         owns whitespace itself, so the Workspaces layer (Formatter, AdhocWorkspace) is not referenced. -->
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <!-- The IR, the printer and the per-node rules are internal; the tests and the benchmark
         exercise them directly. -->
    <InternalsVisibleTo Include="VisualBasicFormatter.Tests" />
    <InternalsVisibleTo Include="VisualBasicFormatter.Bench" />
  </ItemGroup>
</Project>
